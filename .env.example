NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Stream customer subdomain code — safe to expose client-side,
# it's just used to build playback/thumbnail URLs.
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=

# Server-side only — never prefix these with NEXT_PUBLIC_, they must not
# ship to the browser bundle.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM_B64=
